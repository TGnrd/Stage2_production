  procedures :
   -
     name : CallBackPhoto
     procedure_id : 1843207776542219766
     type_code : 14
     code : |1-
      // Résumé : Récupère la scan de l'utilisateur, la sauvegarde sur le téléphone et déclenche l'analyse OCR.
      // Syntaxe :
      // CallBackPhoto (<nNbImages> est entier, <tabImagesScannees> est tableau d'Image)
      //
      // Paramètres :
      //	nNbImages (entier) : Le nombre de scans validés par l'utilisateur.
      //	tabImagesScannees (tableau d'Image) : Le tableau contenant les images capturées en mémoire vive.
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // (Cette procédure est appelée automatiquement en callback par la fonction de scan de l'appareil)
      //
      
      PROCÉDURE CallBackPhoto(LOCAL nNbImages est un entier, LOCAL tabImagesScannees est un tableau d'Image)
      
      // 1. L'utilisateur a annulé la prise de photo (0 image) ?
      SI nNbImages <= 0 OU tabImagesScannees.vide ALORS
      	RETOUR
      FIN
      
      // 2. On sauvegarde l'image initial pour le futur envoie dans la BDD
      sNomFichierOriginal			est une chaîne	= "Scan_Original_" + DateHeureSys() + ".jpg" // Enregistre le fichier une première fois
      sCheminOriginalSauvegarde	est une chaîne	= fRepDonnées() + ["/"] + sNomFichierOriginal // Récupérer le chemin du scan
      
      dSauveImageJPEG(tabImagesScannees[1], sCheminOriginalSauvegarde)
      
      sNomUniqueThread est une chaîne = "Thread_" + DateHeureSys() // Permet de ne jamais avoir le même résultat
      
      // Permet d'attendre que l'appli revienne au premier plan
      ThreadExécute(sNomUniqueThread, threadNormal, ProcAttenteUI)
      
      	// --- PROCÉDURE INTERNE AU CALLBACK ---
      	PROCÉDURE INTERNE ProcAttenteUI()
      		// Pause de 50 centièmes (0.5 seconde) en arrière-plan
      		ThreadPause(50)
      		ExécuteThreadPrincipal(SuiteTraitementOCR, tabImagesScannees[1])
      	FIN
     type : 458752
   -
     name : LancerTraitementOCR
     procedure_id : 1843208562521351882
     type_code : 14
     code : |1-
      // Résumé : Exécute le processus complet d'analyse d'une image : détection du type de Cerfa, redressement, rognage, et recherche de la case ALD.
      // Syntaxe :
      // stMonResultat = LancerTraitementOCR (<imgSource> est Image)
      //
      // Paramètres :
      //	imgSource (Image) : L'image brute du document scan capturée par l'utilisateur.
      // Valeur de retour :
      // 	ST_ResultatOCR : Une structure contenant la version du Cerfa détectée, le résultat de la case ALD (Vrai/Faux), et l'image finale redressée/dessinée.
      //
      // Exemple :
      // stResultat = LancerTraitementOCR(imgMaPhoto)
      //
      
      PROCÉDURE LancerTraitementOCR(LOCAL imgSource est une Image) : ST_ResultatOCR
      
      stRes est un ST_ResultatOCR
      stRes.VersionDetectee	= ""
      stRes.EstALD			= Faux
      
      // Validation initiale
      SI imgSource.Largeur = 0 OU imgSource.Hauteur = 0 ALORS
      	Erreur("L'image reçue est vide ou invalide.")
      	RENVOYER stRes
      FIN
      
      // =================================================================================
      // 1. DÉTECTION DE LA VERSION
      // =================================================================================
      nLargVersion		est un entier	= imgSource.Largeur * 0.20 // Largeur de la recherche de la version
      nHautVersion		est un entier	= imgSource.Hauteur * 0.15 // Hauteur de la recherche de la version
      imgZoneVersion		est une Image	= dDécoupe(imgSource, 0, 0, nLargVersion, nHautVersion) // Découpe de la partie de recherche de la version du document
      sTexteVersionBrut	est une chaîne	= OCRExtraitTexte(imgZoneVersion) // Extraction du texte dans la zone de recherche de la version
      imgScanRedressee est une Image = RedresserEtRogner_PMT(imgSource) // Recadre l'image 
      
      // La procédure recherche la version de la prescription médicale de transport avec de l'OCR
      stRes.VersionDetectee = RecupereVersionCerfa(sTexteVersionBrut)
      
      si stRes.VersionDetectee = "" alors
      	// On arrête tout de suite le traitement
      	// On peut renvoyer un code d'erreur spécifique pour afficher un message personnalisé
      	stRes.VersionDetectee = "ANNULE_ALD"
      	renvoyer stRes
      fin
      
      // =================================================================================
      // 2. REDRESSEMENT ET ROGNAGE
      // =================================================================================
      
      // Si le redressement a échoué et renvoyé une image vide
      SI imgScanRedressee.Largeur = 0 ALORS
      	stRes.VersionDetectee = "ECHEC_SCAN" // On crée un code d'erreur spécial !
      	RENVOYER stRes
      FIN
      
      // =================================================================================
      // 3. DÉTECTION DE L'ALD
      // =================================================================================
      stRes.EstALD		= ALDFinder(imgScanRedressee, stRes.VersionDetectee)
      
      // On met l'image avec les carrés dans notre structure pour l'afficher plus tard
      stRes.ImageDessinee	= imgScanRedressee
      
      // =================================================================================
      // 4. RETOUR DES RÉSULTATS
      // =================================================================================
      RENVOYER stRes
     type : 458752
   -
     name : SuiteTraitementOCR
     procedure_id : 1843514806575508744
     type_code : 14
     code : |1-
      // Résumé : Gère le flux logique après la prise de photo : verrouillage anti-doublon, bypass de l'OCR (selon l'interrupteur utilisateur), gestion des erreurs d'analyse, et affichage de la boîte de dialogue finale de validation.
      // Syntaxe :
      //SuiteTraitementOCR (<imgDeTravail> est Image)
      //
      // Paramètres :
      //	imgDeTravail (Image) : L'image capturée envoyée par la procédure CallBackPhoto pour traitement.
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // ExécuteThreadPrincipal(SuiteTraitementOCR, tabImagesScannees[1])
      //
      
      PROCÉDURE SuiteTraitementOCR(imgDeTravail est une Image)
      
      // =========================================================================
      // 1. FLAG D'EXÉCUTION ET SÉCURITÉ ANTI-REBOND
      // =========================================================================
      // Clause de garde : On vérifie le booléen global d'état.
      // Cela empêche le lancement de traitements parallèles simultanés si l'événement
      // (clic ou retour de caméra) est déclenché plusieurs fois consécutives.
      SI gbAnalyseEnCours = Vrai ALORS
      	RETOUR
      FIN
      
      gbAnalyseEnCours = Vrai
      
      SI pas INT_ActiverALD ALORS
      	nReponseSimple est un entier = Dialogue("Voulez-vous envoyer ce scan (sans analyse) ?", ["Annuler", "Envoyer"], 2, 1)
      
      	SI nReponseSimple = 2 ALORS
      		ToastAffiche("Scan envoyé avec succès.")
      	SINON
      		ToastAffiche("Scan annulé.")
      	FIN
      
      	// On rouvre le verrou et on s'arrête là !
      	gbAnalyseEnCours = Faux
      	RETOUR
      FIN
      
      // =========================================================================
      // 2. TON TRAITEMENT OCR
      // =========================================================================
      
      stMonResultat est un ST_ResultatOCR
      stMonResultat = LancerTraitementOCR(imgDeTravail)
      
      SI stMonResultat.VersionDetectee = "ANNULE_ALD" ALORS
      	Info("La version n'est pas valide, veuillez recommencer.")
      	gbAnalyseEnCours = Faux
      	RETOUR
      FIN
      
      SI stMonResultat.VersionDetectee = "ECHEC_SCAN" ALORS
      	Info("Le document est illisible ou mal cadré.", "Veuillez reprendre la photo.")
      	gbAnalyseEnCours = Faux
      	RETOUR
      FIN
      
      // =========================================================================
      // GESTION DE LA VERSION NON DÉTECTÉE
      // =========================================================================
      SI stMonResultat.VersionDetectee = "" ALORS
      	// 1. On affiche le popup d'avertissement
      	Info("Version du document non reconnue.", "Veuillez reprendre la photo en vous assurant que le coin supérieur gauche (numéro Cerfa) est bien lisible et net.")
      
      	// 2. On rouvre le verrou pour permettre une nouvelle tentative
      	gbAnalyseEnCours = Faux
      
      	// 3. On arrête l'exécution de la procédure ici (la popup finale d'envoi ne s'affichera pas)
      	RETOUR
      FIN
      
      // =======================================================================
      // DÉBUG : Permet d'afficher le résultat du document traité avec les dessins de recherche
      // Ouverture de ta nouvelle fenêtre de débogage
      
      //OuvreFenêtreMobile(FEN_Debug, stMonResultat.ImageDessinee, stMonResultat.VersionDetectee, stMonResultat.EstALD)
      
      // =======================================================================
      
      sTexteAffiche est une chaîne
      sTexteAffiche = "Résumé du scan :" + RC + RC + ...
      "Type de document : Cerfa " + stMonResultat.VersionDetectee + RC + ...
      "ALD Exonérante : " + (stMonResultat.EstALD ? "OUI" SINON "NON") + RC + RC + ...
      "Voulez-vous envoyer ce résultat ?"
      
      nReponse est un entier = Dialogue(sTexteAffiche, ["Annuler", "Envoyer"], 2, 1)
      
      SI nReponse = 2 ALORS
      	// -> Mets ici ton code d'envoi avec les données ALD
      	ToastAffiche("Données validées et envoyées.")
      SINON
      	ToastAffiche("Scan annulé.")
      FIN
      
      // =========================================================================
      // 5. LIBÉRATION DU CONTEXTE
      // =========================================================================
      // Le traitement asynchrone est terminé et l'interface utilisateur a répondu.
      // On réinitialise le flag d'état pour autoriser une nouvelle analyse.
      gbAnalyseEnCours = Faux
     type : 458752
  procedure_templates : []
  property_templates : []
